{
  "manifest_version": 3,
  "name": "Gemini Quiz Helper",
  "version": "1.0.0",
  "description": "Giải đề trắc nghiệm nhanh chóng bằng Google Gemini API. Bôi đen câu hỏi và nhận đáp án ngay lập tức.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["style.css"],
      "js": ["content.js"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Gemini Quiz Helper Settings"
  }
}